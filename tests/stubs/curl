#!/bin/bash
# curl stub for `curl -s -w '\n%{http_code}' URL`: body, newline, status per MUTEX_TEST_CURL (/jobs: MUTEX_TEST_CURL_JOBS).
# `byrun` = completed iff the URL's run id is in MUTEX_TEST_CURL_COMPLETED_RUNS; URLs logged to MUTEX_TEST_URL_LOG.
for __a in "$@"; do :; done
if [ -n "${MUTEX_TEST_URL_LOG:-}" ]; then
	printf '%s\n' "$__a" >> "$MUTEX_TEST_URL_LOG"
fi
case "$__a" in
	*/jobs\?*) printf '%s\n%s' "${MUTEX_TEST_CURL_JOBS:-{\"total_count\":0,\"jobs\":[]}}" "${MUTEX_TEST_CURL_JOBS_CODE:-200}"; exit 0 ;;
esac
__mode=${MUTEX_TEST_CURL:-fail}
if [ "$__mode" = "byrun" ]; then
	__run=$(printf '%s' "$__a" | sed -n 's#.*/actions/runs/\([0-9]*\)/.*#\1#p')
	__mode=in_progress
	for __r in ${MUTEX_TEST_CURL_COMPLETED_RUNS:-}; do
		[ "$__r" = "$__run" ] && __mode=completed
	done
fi
case "$__mode" in
	completed)   printf '%s\n200' '{"status":"completed"}' ;;
	in_progress) printf '%s\n200' '{"status":"in_progress"}' ;;
	queued)      printf '%s\n200' '{"status":"queued"}' ;;
	badjson)     printf '%s\n200' 'this is not json' ;;
	empty)       printf '\n200' ;;
	http401)     printf '%s\n401' '{"message":"Bad credentials"}' ;;
	http403)     printf '%s\n403' '{"message":"Resource not accessible by integration"}' ;;
	http404)     printf '%s\n404' '{"message":"Not Found"}' ;;
	http429)     printf '%s\n429' '{"message":"API rate limit exceeded"}' ;;
	http500)     printf '%s\n500' '{"message":"Server Error"}' ;;
	fail|*)      printf '\n000'; exit 7 ;;
esac
